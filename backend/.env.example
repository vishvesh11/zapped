# Copy to .env and fill in. Loaded automatically by pydantic-settings (config.py).

# API key the admin panel / Pico must send as X-API-Key ("" disables auth)
GAME_API_KEY=changeme

# IP camera snapshot endpoint (Headscale address of the phone running the IP cam)
PHONE_SNAPSHOT_URL=http://100.64.0.8:8080/shot.jpg

# Garage S3 (touch photo storage). The camera test needs these to upload.
S3_ENDPOINT=https://s3.vishvesh.me
S3_REGION=garage
S3_BUCKET=buzzwire-zaps
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional overrides
# PORT=8000
# DB_PATH=./leaderboard.db
# MEDIA_DIR=./media
# SCORE_BASE=1000
# SCORE_PER_SECOND=5
# SCORE_PER_FAULT=50
